[Unit]
Description=Verify and mirror public Human Radar update assets
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /root/project/Human_Radar_V2/tools/sync-update-mirror.sh
TimeoutStartSec=8min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/human-radar-updates /var/lib/human-radar-updates
