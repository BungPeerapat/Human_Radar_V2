<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/radar_bg">

    <!-- Status bar -->
    <LinearLayout
        android:id="@+id/radar_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@color/radar_card">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUMAN RADAR - LD2450"
            android:textColor="@color/radar_green"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_radar_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="@color/radar_red"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@color/radar_input_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Main content: radar canvas (left) + target info (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">

            <com.example.radarhumanapplication.RadarView
                android:id="@+id/radar_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Active device chip (mirrors portrait) — kept in landscape so
                 the user can switch devices without leaving the radar. -->
            <LinearLayout
                android:id="@+id/active_device_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#CC000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:id="@+id/active_device_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/radar_green"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/active_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HumanRadar"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:maxWidth="220dp" />

                <TextView
                    android:id="@+id/active_device_fw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/radar_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@color/radar_input_bg"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ▾"
                    android:textColor="@color/radar_text_dim"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Replay badge (mirrors portrait) — shown while SessionReplayer
                 is active so live vs replay frames are visually distinct. -->
            <LinearLayout
                android:id="@+id/replay_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:background="#CCFFB300"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/replay_badge_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶ REPLAY"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/replay_badge_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/radar_ux_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:orientation="horizontal"
                android:background="#80000000"
                android:padding="2dp">

                <ImageButton
                    android:id="@+id/btn_keep_screen_on"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Keep screen on" />

                <ImageButton
                    android:id="@+id/btn_manual_rotate"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Manual rotate" />

                <ImageButton
                    android:id="@+id/btn_lock_orientation"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Lock orientation" />

                <ImageButton
                    android:id="@+id/btn_night_mode"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Night mode" />

                <ImageButton
                    android:id="@+id/btn_snapshot"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Snapshot" />

                <ImageButton
                    android:id="@+id/btn_multi_device"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Show multiple devices" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/radar_info_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Targets"
                android:textColor="@color/radar_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_radar_t1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="T1  ---"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/radar_input_bg" />

            <TextView
                android:id="@+id/tv_radar_t2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="T2  ---"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/radar_input_bg" />

            <TextView
                android:id="@+id/tv_radar_t3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="T3  ---"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingVertical="4dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_radar_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frames: 0 | Errors: 0 | FPS: 0"
                android:textColor="@color/radar_text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="6dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
