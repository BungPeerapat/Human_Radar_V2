<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/radar_card"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_alert_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rule_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Any  &lt;= 1.0m"
            android:textColor="@color/radar_green"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rule_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm • Default ringtone"
            android:textColor="@color/radar_text_dim"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_rule_edit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit"
        android:layout_marginStart="4dp" />

    <ImageButton
        android:id="@+id/btn_rule_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete"
        android:layout_marginStart="4dp" />
</LinearLayout>
