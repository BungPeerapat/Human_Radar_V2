<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/radar_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Legacy "Sensor Configuration" card removed in v1.0.56.
             Replaced by the HTTP-based "Sensor Behavior" card (below the
             Alert card) and the "Detection Zones" dialog accessible from it.
             Both write through /api/config which the firmware validates
             with hasKey() partial-update guards. -->

        <!-- Alert / Buzzer (GPIO26) Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buzzer + LED Alert (GPIO26)"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/alert_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Alert (master)"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/alert_led_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LED WiFi indicator (ESP32 only)"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Short beep (ms) [50-5000]"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alert_short_ms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Long beep (ms) [100-10000]"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alert_long_ms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gap between beeps (ms) [50-5000]"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alert_gap_ms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Debounce (ms) [0-10000]"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alert_debounce_ms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Max detect range (mm) [0=unlimited]"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alert_max_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile sound (this phone only)"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/alert_sound_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <RadioButton
                    android:id="@+id/alert_sound_tone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tone"
                    android:textColor="@color/white"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/alert_sound_wav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAV"
                    android:textColor="@color/white"
                    android:layout_marginStart="12dp" />
                <RadioButton
                    android:id="@+id/alert_sound_tts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TTS"
                    android:textColor="@color/white"
                    android:layout_marginStart="12dp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/alert_short_uri_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Short beep sound: (none)"
                    android:textColor="@color/radar_text_dim"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_short"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PICK SHORT BEEP SOUND"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/alert_long_uri_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Long beep sound: (none)"
                    android:textColor="@color/radar_text_dim"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_long"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PICK LONG BEEP SOUND"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/alert_volume_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile volume: 100%"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/alert_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100"
                android:stepSize="5"
                android:value="100"
                android:layout_marginBottom="8dp" />

            <!-- Audio routing picker. NOTIFICATION (default) plays through
                 whatever output is connected — headphones plugged in =
                 sound only in headphones. ALARM forces Android to play
                 through speaker AND any connected output at the same time
                 (matches an alarm clock) so it can't be silenced by
                 plugging in headphones. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio routing"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/alert_routing_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/alert_routing_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎧  Follow headphones (notification)"
                    android:textSize="13sp"
                    android:checked="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Default. Plug in headphones → sound only in headphones."
                    android:textSize="11sp"
                    android:textColor="@color/radar_text_dim"
                    android:paddingStart="32dp"
                    android:layout_marginBottom="4dp" />

                <RadioButton
                    android:id="@+id/alert_routing_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔔  Force speaker + headphones (alarm)"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plays out of both at once — can't be silenced by plugging in headphones."
                    android:textSize="11sp"
                    android:textColor="@color/radar_text_dim"
                    android:paddingStart="32dp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="ESP32 device IP (auto from MQTT)"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/alert_device_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_device_ip"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PICK"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_alert_fetch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="FETCH"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_alert_push"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PUSH"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_alert_test_local"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="TEST PHONE"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_alert_test_remote"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="TEST ESP32"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/alert_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Sensor Behavior Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensor Behavior"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sensor_pub_interval_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publish interval: 100 ms"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensor_pub_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="50"
                android:valueTo="2000"
                android:stepSize="50"
                android:value="100"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sensor_unmanned_delay_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unmanned delay: 5000 ms"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensor_unmanned_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1000"
                android:valueTo="60000"
                android:stepSize="500"
                android:value="5000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sensor_target_timeout_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target timeout: 1000 ms"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensor_target_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="100"
                android:valueTo="10000"
                android:stepSize="100"
                android:value="1000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/sensor_sensitivity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensitivity: 5"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensor_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="9"
                android:stepSize="1"
                android:value="5"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/sensor_multi_target_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <RadioButton
                    android:id="@+id/sensor_multi_target_single"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Single target"
                    android:textColor="@color/white" />
                <RadioButton
                    android:id="@+id/sensor_multi_target_multi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Multi target (up to 3)"
                    android:textColor="@color/white"
                    android:checked="true" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sensor_btn_edit_zones"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit detection zones…"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensor_btn_fetch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="FETCH"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sensor_btn_push"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PUSH"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sensor_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- WiFi Setup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi Setup"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tell the ESP32 which WiFi to join. The device will reboot after saving; if STA fails it falls back to AP mode after ~10 s."
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/wifi_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <RadioButton
                    android:id="@+id/wifi_mode_sta"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="STA (join my WiFi)"
                    android:textColor="@color/white"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/wifi_mode_ap"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="AP (device hosts WiFi)"
                    android:textColor="@color/white" />
            </RadioGroup>

            <!-- Exposed-dropdown so the SSID field doubles as a manual entry +
                 picker of nearby networks the phone can scan. -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="WiFi SSID (tap ▾ to pick a nearby network)"
                android:layout_marginBottom="6dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/wifi_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="text"
                    android:maxLength="32" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="WiFi password (empty = open network)"
                android:layout_marginBottom="8dp"
                app:passwordToggleEnabled="true"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                xmlns:app="http://schemas.android.com/apk/res-auto">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/wifi_pass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:inputType="textPassword"
                    android:maxLength="64" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Auto Find WiFi: keep retrying STA + AP rescue so the device
                 self-heals after the router drops, instead of getting stuck
                 in AP mode and needing a power-cycle. -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/wifi_auto_reconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto Find WiFi (auto-reconnect)"
                android:textColor="@color/white"
                android:checked="true"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If WiFi drops, the device keeps retrying and keeps the HumanRadar AP up as a backup — no power-cycle needed."
                android:textColor="@color/radar_text_dim"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi_fetch"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="FETCH CURRENT"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi_apply"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="APPLY &amp; RESTART"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wifi_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Device Online/Offline Notifications Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Online / Offline Notifications"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/dev_alert_device_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuring: (current device)"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Online row -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dev_alert_online_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play sound when device comes ONLINE"
                android:textColor="@color/white"
                android:checked="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/dev_alert_online_uri_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Online sound: (none)"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dev_alert_pick_online"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PICK ONLINE SOUND"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dev_alert_test_online"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="TEST ONLINE"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Offline row -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dev_alert_offline_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play sound when device goes OFFLINE"
                android:textColor="@color/white"
                android:checked="true"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/dev_alert_offline_uri_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline sound: (none)"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dev_alert_pick_offline"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PICK OFFLINE SOUND"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dev_alert_test_offline"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="TEST OFFLINE"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dev_alert_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Config ACK Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Config Response"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_config_ack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No response yet"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ESP32 Firmware OTA Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESP32 Firmware (OTA)"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload a firmware .bin to the selected ESP32 over WiFi. The device verifies the image, flashes it to the OTA partition and reboots."
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/fw_picked_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Firmware file: (none)"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fw_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHECK FIRMWARE UPDATE"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fw_pick"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PICK FIRMWARE .BIN (manual)"
                android:layout_marginBottom="6dp" />

            <!-- Prominent percent + progress bar shown during OTA. -->
            <TextView
                android:id="@+id/fw_progress_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/radar_blue"
                android:textSize="34sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="monospace"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/fw_progress_phase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/fw_progress"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                app:trackThickness="12dp"
                app:indicatorColor="@color/radar_blue"
                app:trackCornerRadius="6dp"
                android:layout_marginBottom="8dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:id="@+id/fw_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fw_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UPLOAD TO ESP32"
                android:enabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/radar_input_bg" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_beta_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use beta channel for app/firmware updates"
                android:textColor="@color/white"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fw_skip_version"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SKIP CURRENT FIRMWARE VERSION"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fw_rollback"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/radar_red"
                android:text="ROLLBACK TO PREVIOUS FIRMWARE" />
        </LinearLayout>

        <!-- App Update Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/radar_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Update"
                android:textColor="@color/radar_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current: -"
                android:textColor="@color/radar_text_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHECK FOR UPDATES" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
